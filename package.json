{
  "name": "@phun-ky/angle",
  "version": "1.0.66",
  "description": "A JavaScript function to calculate the angle between two coordinates",
  "keywords": [
    "math",
    "cartesian",
    "coordinates",
    "direction",
    "atan",
    "atan2",
    "theta",
    "pi",
    "Math.PI",
    "radian",
    "radians",
    "degree",
    "degrees",
    "angle"
  ],
  "homepage": "https://github.com/phun-ky/angle#readme",
  "bugs": {
    "url": "https://github.com/phun-ky/angle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/angle.git"
  },
  "funding": "https://github.com/phun-ky/angle?sponsor=1",
  "license": "MIT",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "type": "module",
  "main": "./dist/angle.cjs",
  "module": "./dist/angle.esm.js",
  "types": "./dist/angle.d.ts",
  "unpkg": "./dist/angle.js",
  "jsdelivr": "./dist/angle.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/angle.d.ts",
        "default": "./dist/angle.esm.js"
      },
      "require": {
        "types": "./dist/angle.d.cts",
        "default": "./dist/angle.cjs"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run rollup",
    "check:pack": "node scripts/check-pack.mjs",
    "clean": "rm -rf dist dts",
    "commit": "npx git-cz",
    "docs:gen": "node ./node_modules/.bin/typedoc",
    "docs:check": "typedoc --emit none --treatWarningsAsErrors",
    "release": "release-it",
    "release:dry-run": ".github/scripts/should-release.sh && release-it --ci --dry-run --github.release=false --no-git.requireCleanWorkingDir --no-git.requireUpstream",
    "rollup": "rollup -c",
    "prerollup:dev": "npm run clean",
    "rollup:dev": "rollup -c -w",
    "style:format": "eslint . --fix",
    "style:lint": "eslint .",
    "test": "node --import tsx --test --enable-source-maps 'src/**/__tests__/**/*.ts'",
    "pretest:ci": "rm -rf coverage && mkdir -p coverage",
    "test:ci": "node --import tsx --test --enable-source-maps --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/__tests__/**' --test-coverage-lines=99 --test-coverage-functions=100 --test-coverage-branches=95 --test-reporter=cobertura --test-reporter-destination=coverage/cobertura-coverage.xml --test-reporter=spec --test-reporter-destination=stdout 'src/**/__tests__/**/*.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@phun-ky/typeof": "^3.0.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.19.2",
    "cobertura": "^1.0.1",
    "eslint": "^10.0.0",
    "eslint-config-phun-ky": "^2.0.10",
    "git-cz": "^4.9.0",
    "globals": "^17.13.0",
    "prettier": "^3.2.5",
    "publint": "^0.3.25",
    "release-it": "^21.1.1",
    "remark-github": "^12.0.0",
    "remark-toc": "^9.0.0",
    "rollup": "^4.12.0",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "tsx": "^4.7.1",
    "typedoc": "^0.28.3",
    "typedoc-plugin-markdown": "^4.2.3",
    "typedoc-plugin-mdn-links": "^5.0.1",
    "typedoc-plugin-remark": "^2.0.0",
    "typedoc-plugin-rename-defaults": "^0.7.1",
    "typescript": "^6.0.3",
    "unified-prettier": "^2.0.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.8.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "^6.2.3"
    }
  }
}
